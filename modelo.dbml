// Índices adicionais, inclusive UNIQUE parcial da classe inicial: consultar schema.sql.
// character_summary.total_level é derivado; não é coluna persistida.

// Índices parciais de refresh e auth_token no SQL.
// Política de acesso é do serviço; publication_blocked_at impede republicação após moderação.

Table character_choice {
  id integer [pk, increment]
  character_id integer [not null]
  grant_id integer [not null]
  choice_id text [not null, note: 'id ItemChoice do pacote; 1–200 caracteres não vazios']
  option_id text [not null, note: 'id ChoiceOption da opção; 1–200 caracteres não vazios']
  created_at text [not null, note: 'ISO 8601 UTC; padrão gerado pelo SQLite']
  indexes {
    (grant_id, choice_id, option_id) [unique]
    (character_id, grant_id)
  }
}
Ref: character_choice.(character_id, grant_id) > character_rule_grant.(character_id, id) [delete: cascade]
