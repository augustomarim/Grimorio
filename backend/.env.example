NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=
# URL direta opcional para migrações e backups; não incluir segredos no Git.
DIRECT_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Gere um segredo aleatório de pelo menos 32 bytes; não envie ao Git.
AUTH_KEY=
# Habilite explicitamente apenas em desenvolvimento para registrar e-mails em arquivo privado.
MAIL_MODE=disabled
MAIL_DIRECTORY=./data/mail

# Produção: HTTPS, IP/CIDR do proxy confiável. Para recuperação de senha, use MAIL_MODE=resend ou smtp.
TRUSTED_PROXIES=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Render: API_PREFIX=/api; a API usa RENDER_EXTERNAL_URL automaticamente.
API_PREFIX=
PUBLIC_API_ORIGIN=
COOKIE_SAME_SITE=lax
# TRUSTED_PROXIES também aceita CIDRs explícitos. Não use * ou 0.0.0.0/0.
# Alternativa HTTPS para e-mail transacional, sem login Google.
RESEND_API_KEY=
MAIL_FROM=
