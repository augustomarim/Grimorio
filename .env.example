NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=
# URL direta opcional para migrações e backups; não incluir segredos no Git.
DIRECT_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Gere um segredo aleatório de pelo menos 32 bytes; não envie ao Git.
AUTH_KEY=
# Habilite explicitamente apenas em desenvolvimento para registrar e-mails em arquivo privado.
MAIL_MODE=disabled
MAIL_DIRECTORY=./data/mail

# Produção: HTTPS, MAIL_MODE=smtp e IP exato do proxy confiável.
TRUSTED_PROXIES=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
