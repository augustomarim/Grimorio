Project Grimorio {
 database_type: 'PostgreSQL'
 Note: 'Neon / PostgreSQL 17. Schema PostgreSQL v1. Total de níveis = SUM(character_class.level); atributos base e bônus separados.'
}

Table app_user {
 id integer [pk, increment, not null]
 email citext [not null]
 username citext [not null]
 password_hash text [not null]
 role text [not null, note: 'default: \'user\'::text']
 is_active integer [not null, note: 'default: 1']
 email_verified_at text
 last_login_at text
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 updated_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 indexes {
 (email) [unique]
 (username) [unique]
 }
}

Table audit_log {
 id integer [pk, increment, not null]
 actor_user_id integer
 action text [not null]
 entity_type text [not null]
 entity_id integer
 details text
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
}

Table auth_token {
 id integer [pk, increment, not null]
 user_id integer [not null]
 purpose text [not null]
 token_hash text [not null]
 expires_at text [not null]
 used_at text
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 issued_email_hash text
 revoked_at text
 indexes {
 (token_hash) [unique]
 }
}

Table catalog_entry {
 id integer [pk, increment, not null]
 kind text [not null]
 slug text [not null]
 name text [not null]
 deprecated_at text
 indexes {
 (id, kind) [unique]
 (kind, slug) [unique]
 }
}

Table catalog_entry_source {
 catalog_entry_id integer [not null]
 source_id integer [not null]
 indexes {
 (catalog_entry_id, source_id) [pk]
 }
}

Table character {
 id integer [pk, increment, not null]
 owner_id integer [not null]
 system_id integer [not null]
 name text [not null]
 portrait text
 is_public integer [not null, note: 'default: 0']
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 updated_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 publication_blocked_at text
 indexes {
 (id, system_id) [unique]
 }
}

Table character_ability {
 id integer [pk, increment, not null]
 character_id integer [not null]
 lib_feat_id integer
 lib_tool_id integer
 lib_language_id integer
 notes text
 grant_id integer [not null]
 selection_kind text [not null]
 choice_key text
 proficiency_rank integer
 indexes {
 (character_id, id, lib_feat_id) [unique]
 }
}

Table character_ability_boost {
 id integer [pk, increment, not null]
 character_id integer [not null]
 grant_id integer [not null]
 rule_id text [not null]
 ability text [not null]
 amount integer [not null]
 indexes {
 (grant_id, rule_id, ability) [unique]
 }
}

Table character_armor_training {
 id integer [pk, increment, not null]
 character_id integer [not null]
 grant_id integer [not null]
 selection_kind text [not null]
 choice_key text
 notes text
 armor_kind text [not null]
 indexes {
 (grant_id, armor_kind) [unique]
 }
}

Table character_choice {
 id integer [pk, increment, not null]
 character_id integer [not null]
 grant_id integer [not null]
 choice_id text [not null]
 option_id text [not null]
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 indexes {
 (grant_id, choice_id, option_id) [unique]
 }
}

Table character_class {
 id integer [pk, increment, not null]
 character_id integer [not null]
 class_id integer [not null]
 level integer [not null]
 subclass_id integer
 is_initial_class integer [not null, note: 'default: 0']
 indexes {
 (character_id, class_id) [unique]
 (character_id, id) [unique]
 (character_id, id, subclass_id) [unique]
 }
}

Table character_fighting_style {
 id integer [pk, increment, not null]
 character_id integer [not null]
 lib_fighting_style_id integer [not null]
 source text [not null, note: 'default: \'class\'::text']
 notes text
 indexes {
 (character_id, lib_fighting_style_id) [unique]
 }
}

Table character_hit_point_bonus {
 id integer [pk, increment, not null]
 character_id integer [not null]
 grant_id integer [not null]
 selection_kind text [not null]
 choice_key text
 notes text
 bonus_kind text [not null]
 amount integer [not null]
 target_character_class_id integer
 indexes {
 (grant_id, bonus_kind, target_character_class_id) [unique]
 }
}

Table character_item {
 id integer [pk, increment, not null]
 character_id integer [not null]
 lib_item_id integer [not null]
 quantity integer [not null, note: 'default: 1']
 equipped integer [not null, note: 'default: 0']
 notes text
}

Table character_level_entry {
 id integer [pk, increment, not null]
 character_id integer [not null]
 character_class_id integer [not null]
 sequence_no integer [not null]
 hp_method text [not null]
 hp_roll integer
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 notes text
 indexes {
 (character_id, sequence_no) [unique]
 }
}

Table character_narrative {
 character_id integer [pk, increment, not null]
 backstory text
 description text
 personality text
 motivations text
 goals text
 updated_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
}

Table character_rule_grant {
 id integer [pk, increment, not null]
 character_id integer [not null]
 origin_kind text [not null]
 origin_character_class_id integer
 origin_subclass_id integer
 origin_species_id integer
 origin_background_id integer
 origin_character_ability_id integer
 origin_feat_id integer
 acquisition_context text [not null]
 rule_key text [not null]
 acquired_at_level integer [not null]
 notes text
 indexes {
 (character_id, id) [unique]
 (character_id, rule_key) [unique]
 }
}

Table character_saving_throw {
 id integer [pk, increment, not null]
 character_id integer [not null]
 grant_id integer [not null]
 selection_kind text [not null]
 choice_key text
 notes text
 ability text [not null]
 indexes {
 (grant_id, ability) [unique]
 }
}

Table character_skill {
 id integer [pk, increment, not null]
 character_id integer [not null]
 grant_id integer [not null]
 selection_kind text [not null]
 choice_key text
 notes text
 skill_id integer [not null]
 proficiency_rank integer [not null]
 indexes {
 (grant_id, skill_id) [unique]
 }
}

Table character_spell {
 id integer [pk, increment, not null]
 character_id integer [not null]
 lib_spell_id integer [not null]
 origin_kind text [not null]
 origin_character_class_id integer
 origin_subclass_id integer
 origin_species_id integer
 origin_background_id integer
 origin_character_ability_id integer
 origin_feat_id integer
 preparation_mode text [not null]
 is_prepared integer [not null, note: 'default: 0']
 casting_ability_choice text
 notes text
 choice_instance_id integer
 nested_choice_key text
}

Table character_spellbook_entry {
 id integer [pk, increment, not null]
 character_id integer [not null]
 character_class_id integer [not null]
 lib_spell_id integer [not null]
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 notes text
 indexes {
 (character_class_id, lib_spell_id) [unique]
 }
}

Table character_weapon_mastery {
 id integer [pk, increment, not null]
 character_id integer [not null]
 grant_id integer [not null]
 selection_kind text [not null]
 choice_key text
 notes text
 weapon_item_id integer [not null]
 indexes {
 (grant_id, weapon_item_id) [unique]
 }
}

Table character_weapon_training {
 id integer [pk, increment, not null]
 character_id integer [not null]
 grant_id integer [not null]
 selection_kind text [not null]
 choice_key text
 notes text
 clause_key text [not null]
 weapon_item_id integer
 category text
 weapon_range text
 indexes {
 (grant_id, clause_key) [unique]
 }
}

Table character_weapon_training_property {
 training_id integer [not null]
 property_id integer [not null]
 predicate text [not null]
 indexes {
 (training_id, property_id) [pk]
 }
}

Table dnd_character {
 character_id integer [pk, increment, not null]
 system_id integer [not null]
 system_code text [not null, note: 'default: \'dnd-2024\'::text']
 strength integer [not null]
 dexterity integer [not null]
 constitution integer [not null]
 intelligence integer [not null]
 wisdom integer [not null]
 charisma integer [not null]
 species_id integer [not null]
 background_id integer
 alignment_id integer
 ruleset_revision_id integer [not null]
 campaign_setting text
 indexes {
 (character_id, background_id) [unique]
 (character_id, species_id) [unique]
 }
}

Table lib_alignment {
 id integer [pk, increment, not null]
 abbr text [not null]
 order_axis text [not null]
 morality_axis text [not null]
 body text
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'alignment\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_background {
 id integer [pk, increment, not null]
 setting text
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'background\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_class {
 id integer [pk, increment, not null]
 hit_die integer
 is_spellcaster integer [not null, note: 'default: 0']
 subclass_level integer [not null]
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'class\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_feat {
 id integer [pk, increment, not null]
 category text
 setting text
 is_repeatable integer [not null, note: 'default: 0']
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'feat\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_fighting_style {
 id integer [pk, increment, not null]
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'fighting_style\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_item {
 id integer [pk, increment, not null]
 kind text [not null]
 rarity text
 is_magic integer [not null, note: 'default: 0']
 cost_cp integer
 weight real
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'item\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_language {
 id integer [pk, increment, not null]
 tier text [not null]
 origin text
 is_always integer [not null, note: 'default: 0']
 note text
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'language\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_link {
 id integer [pk, increment, not null]
 link_key text [not null]
 from_type text [not null]
 from_slug text [not null]
 kind text [not null]
 to_type text [not null]
 to_slug text [not null]
 indexes {
 (link_key) [unique]
 }
}

Table lib_rule {
 id integer [pk, increment, not null]
 category text
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'rule\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_skill {
 id integer [pk, increment, not null]
 ability text [not null]
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'skill\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_species {
 id integer [pk, increment, not null]
 setting text
 creature_type text
 speed integer
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'species\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_spell {
 id integer [pk, increment, not null]
 level integer [not null]
 school text [not null]
 is_concentration integer [not null, note: 'default: 0']
 is_ritual integer [not null, note: 'default: 0']
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'spell\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_subclass {
 id integer [pk, increment, not null]
 class_id integer [not null]
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'subclass\'::text']
 indexes {
 (catalog_entry_id) [unique]
 (class_id, id) [unique]
 }
}

Table lib_tool {
 id integer [pk, increment, not null]
 group_id integer [not null]
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'tool\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_tool_group {
 id integer [pk, increment, not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'tool_group\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_weapon_definition {
 item_id integer [pk, increment, not null]
 category text [not null]
 weapon_range text [not null]
 mastery_id integer
}

Table lib_weapon_mastery {
 id integer [pk, increment, not null]
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'weapon_mastery\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_weapon_property {
 id integer [pk, increment, not null]
 data text [not null]
 catalog_entry_id integer [not null]
 catalog_kind text [not null, note: 'default: \'weapon_property\'::text']
 indexes {
 (catalog_entry_id) [unique]
 }
}

Table lib_weapon_property_link {
 item_id integer [not null]
 property_id integer [not null]
 indexes {
 (item_id, property_id) [pk]
 }
}

Table login_throttle {
 id integer [pk, increment, not null]
 scope text [not null]
 key_hash text [not null]
 window_started_at text [not null]
 failure_count integer [not null, note: 'default: 0']
 blocked_until text
 expires_at text [not null]
 updated_at text [not null]
 indexes {
 (scope, key_hash) [unique]
 }
}

Table refresh_token {
 id integer [pk, increment, not null]
 session_id integer [not null]
 token_hash text [not null]
 parent_token_id integer
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 expires_at text [not null]
 used_at text
 revoked_at text
 indexes {
 (parent_token_id) [unique]
 (session_id, id) [unique]
 (token_hash) [unique]
 }
}

Table rpg_system {
 id integer [pk, increment, not null]
 code text [not null]
 name text [not null]
 edition text [not null]
 is_enabled integer [not null, note: 'default: 0']
 indexes {
 (code) [unique]
 (id, code) [unique]
 }
}

Table rules_source {
 id integer [pk, increment, not null]
 slug text [not null]
 name text [not null]
 source_type text [not null]
 edition text [not null]
 bibliographic_reference text
 reference_url text
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 indexes {
 (slug) [unique]
 }
}

Table ruleset_revision {
 id integer [pk, increment, not null]
 revision text [not null]
 library_version text [not null]
 loaded_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 indexes {
 (revision) [unique]
 }
}

Table schema_migration {
 version integer [pk, not null]
 name text [not null]
 checksum_sha256 text [not null]
 applied_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
}

Table session {
 id integer [pk, increment, not null]
 user_id integer [not null]
 token_hash text [not null]
 created_at text [not null, note: 'default: to_char((clock_timestamp() AT TIME ZONE \'UTC\'::text), \'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"\'::text)']
 expires_at text [not null]
 revoked_at text
 ip_address text
 user_agent text
 access_expires_at text
 indexes {
 (token_hash) [unique]
 }
}

Ref: audit_log.(actor_user_id) > app_user.(id) [delete: set null]
Ref: auth_token.(user_id) > app_user.(id) [delete: cascade]
Ref: catalog_entry_source.(catalog_entry_id) > catalog_entry.(id) [delete: cascade]
Ref: catalog_entry_source.(source_id) > rules_source.(id) [delete: restrict]
Ref: character.(owner_id) > app_user.(id) [delete: restrict]
Ref: character.(system_id) > rpg_system.(id) [delete: restrict]
Ref: character_ability.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_ability.(character_id, grant_id) > character_rule_grant.(character_id, id) [delete: cascade]
Ref: character_ability.(lib_feat_id) > lib_feat.(id) [delete: restrict]
Ref: character_ability.(lib_language_id) > lib_language.(id) [delete: restrict]
Ref: character_ability.(lib_tool_id) > lib_tool.(id) [delete: restrict]
Ref: character_ability_boost.(character_id, grant_id) > character_rule_grant.(character_id, id) [delete: cascade]
Ref: character_armor_training.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_armor_training.(character_id, grant_id) > character_rule_grant.(character_id, id) [delete: cascade]
Ref: character_choice.(character_id, grant_id) > character_rule_grant.(character_id, id) [delete: cascade]
Ref: character_class.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_class.(class_id) > lib_class.(id) [delete: restrict]
Ref: character_class.(class_id, subclass_id) > lib_subclass.(class_id, id) [delete: restrict]
Ref: character_fighting_style.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_fighting_style.(lib_fighting_style_id) > lib_fighting_style.(id) [delete: restrict]
Ref: character_hit_point_bonus.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_hit_point_bonus.(character_id, grant_id) > character_rule_grant.(character_id, id) [delete: cascade]
Ref: character_hit_point_bonus.(character_id, target_character_class_id) > character_class.(character_id, id) [delete: cascade]
Ref: character_item.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_item.(lib_item_id) > lib_item.(id) [delete: restrict]
Ref: character_level_entry.(character_id, character_class_id) > character_class.(character_id, id) [delete: cascade]
Ref: character_level_entry.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_rule_grant.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_rule_grant.(character_id, origin_background_id) > dnd_character.(character_id, background_id) [delete: cascade]
Ref: character_rule_grant.(character_id, origin_character_ability_id, origin_feat_id) > character_ability.(character_id, id, lib_feat_id) [delete: cascade]
Ref: character_rule_grant.(character_id, origin_character_class_id, origin_subclass_id) > character_class.(character_id, id, subclass_id) [delete: cascade]
Ref: character_rule_grant.(character_id, origin_character_class_id) > character_class.(character_id, id) [delete: cascade]
Ref: character_rule_grant.(character_id, origin_species_id) > dnd_character.(character_id, species_id) [delete: cascade]
Ref: character_saving_throw.(character_id) > dnd_character.(character_id) [delete: cascade]
Ref: character_saving_throw.(character_id, grant_id) > character_rule_grant.(character_id, id) [delete: cascade]
Ref: character_skill.(character_id) > dnd_character.(character_id) [delete: cascade]
