# Neon: conexão pooled para API; direta para operações administrativas.
DATABASE_URL=
DIRECT_DATABASE_URL=

API_PREFIX=/api
PUBLIC_API_ORIGIN=https://api.example.com
COOKIE_SAME_SITE=lax
RESEND_API_KEY=
MAIL_FROM=noreply@example.com
