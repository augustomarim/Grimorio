{
  "name": "grimorio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend --",
    "build": "npm run build --workspace backend --",
    "start": "npm run start --workspace backend --",
    "db:migrate": "npm run db:migrate --workspace backend --",
    "catalog:import": "npm run catalog:import --workspace backend --",
    "test": "npm run test --workspace backend --",
    "test:model": "npm run test:model --workspace backend --",
    "typecheck": "npm run typecheck --workspace backend --",
    "admin:promote": "npm run admin:promote --workspace backend --",
    "format": "npm run format --workspace backend && prettier --write package.json scripts .github/workflows deploy/compose.yaml render.yaml deploy/vercel-proxy.example.json",
    "format:check": "npm run format:check --workspace backend && prettier --check package.json scripts .github/workflows deploy/compose.yaml render.yaml deploy/vercel-proxy.example.json",
    "db:backup": "npm run db:backup --workspace backend --",
    "db:verify-backup": "npm run db:verify-backup --workspace backend --",
    "db:restore": "npm run db:restore --workspace backend --",
    "db:transfer-sqlite": "npm run db:transfer-sqlite --workspace backend --",
    "db:backup-encrypted": "npm run db:backup-encrypted --workspace backend --",
    "db:decrypt-backup": "npm run db:decrypt-backup --workspace backend --",
    "verify": "npm run typecheck && npm run build && npm run format:check && npm run test:integration",
    "test:integration": "node scripts/test-integration.mjs"
  }
}
